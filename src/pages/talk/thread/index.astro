---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Talk (unavailable)" description="Talk is temporarily disabled.">
  <section class="mx-auto max-w-lg space-y-6 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-sky-700 dark:text-sky-200">Talk</p>
    <h1 class="text-2xl font-semibold tracking-tight md:text-3xl">Temporarily unavailable</h1>
    <p class="text-sm text-slate-600 dark:text-slate-300">
      Threads are not available right now. Head back to the homepage or open News from the menu.
    </p>
    <a
      class="inline-flex rounded-full bg-sky-100 px-5 py-2 text-sm font-semibold text-sky-800 transition hover:bg-sky-200 dark:bg-sky-400/15 dark:text-sky-200 dark:hover:bg-sky-400/25"
      href={baseUrl}
    >
      Back to home
    </a>
  </section>
</BaseLayout>
