---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Talk" description="Anonymous topics and shared links.">
  <section class="space-y-10" data-talk-page>
    <header class="space-y-4">
      <p class="text-xs uppercase tracking-[0.3em] text-sky-700 dark:text-sky-200">Talk</p>
      <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Share a topic. Keep it human.</h1>
      <p class="max-w-2xl text-base text-slate-600 dark:text-slate-300">
        *Anonymous*, text-only conversations with shareable links. "Be respectful".
      </p>
    </header>

    <section class="rounded-2xl border border-slate-200 bg-white/80 p-5 dark:border-slate-800/60 dark:bg-slate-900/40">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Start a topic</p>
          <p class="text-sm text-slate-600 dark:text-slate-300">Text and links only. No images.</p>
        </div>
        <span class="text-xs uppercase tracking-[0.3em] text-slate-400 dark:text-slate-500">
          Anonymous
        </span>
      </div>
      <form class="mt-4 grid gap-3" data-talk-form>
        <div class="grid gap-3 md:grid-cols-2">
          <div>
            <label class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" for="talk-title">
              Title
            </label>
            <input
              id="talk-title"
              name="title"
              type="text"
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-sky-400 focus:outline-none dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-100"
              placeholder="What should we build next?"
              data-talk-title
              required
            />
          </div>
          <div>
            <label class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" for="talk-name">
              Display name (optional)
            </label>
            <input
              id="talk-name"
              name="author_name"
              type="text"
              class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-sky-400 focus:outline-none dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-100"
              placeholder="Anon"
              data-talk-author
            />
          </div>
        </div>
        <div>
          <label class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" for="talk-body">
            Topic
          </label>
          <textarea
            id="talk-body"
            name="body"
            class="mt-2 min-h-[140px] w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-sky-400 focus:outline-none dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-100"
            placeholder="Share context, include links if helpful..."
            data-talk-body
            required
          ></textarea>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-4">
            <label class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
              <input type="checkbox" data-talk-unlisted />
              Unlisted
            </label>
            <label class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
              <input type="checkbox" data-talk-voice-toggle />
              Voice chat
            </label>
          </div>
          <button
            type="submit"
            class="rounded-2xl border border-slate-200 bg-slate-100 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-700/60 dark:bg-slate-900/60 dark:text-slate-200 dark:hover:text-sky-200"
            data-talk-submit
          >
            Publish topic
          </button>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400" data-talk-form-status></p>
      </form>
    </section>

    <section data-talk-list aria-live="polite" aria-busy="false" class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Topics</p>
          <h2 class="text-2xl font-semibold">Join the conversation</h2>
        </div>
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Topic filters">
          <button class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-[0.3em] text-slate-600 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-800/60 dark:text-slate-300 dark:hover:text-sky-200" type="button" data-talk-filter="open" aria-pressed="true">
            Open
          </button>
          <button class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-[0.3em] text-slate-600 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-800/60 dark:text-slate-300 dark:hover:text-sky-200" type="button" data-talk-filter="archived" aria-pressed="false">
            Archived
          </button>
        </div>
      </div>

      <div class="space-y-4" data-talk-list-items>
        <div class="space-y-4" data-skeleton aria-hidden="true">
          {Array.from({ length: 3 }).map(() => (
            <div class="animate-pulse rounded-2xl border border-slate-200 bg-white/80 px-6 py-5 dark:border-slate-800/60 dark:bg-slate-900/40">
              <div class="h-3 w-24 rounded bg-slate-200 dark:bg-slate-800/80"></div>
              <div class="mt-3 h-4 w-2/3 rounded bg-slate-200 dark:bg-slate-800/80"></div>
              <div class="mt-2 h-3 w-full rounded bg-slate-100 dark:bg-slate-800/60"></div>
            </div>
          ))}
        </div>
        <p class="hidden text-sm text-slate-600 dark:text-slate-300" data-empty role="status">
          No topics yet.
        </p>
        <p class="hidden text-sm text-rose-600 dark:text-rose-300" data-error role="alert">
          Unable to load topics. Check your Supabase configuration.
        </p>
        <div class="hidden space-y-4" data-list></div>
        <template>
          <a
            class="block rounded-2xl border border-slate-200 bg-white/80 px-6 py-5 transition hover:border-sky-400/60 hover:bg-slate-100 dark:border-slate-800/60 dark:bg-slate-900/40 dark:hover:bg-slate-900/60"
            data-talk-link
          >
            <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" data-meta></div>
            <h3 class="mt-3 text-lg font-semibold text-slate-900 dark:text-slate-100" data-title></h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300" data-preview></p>
          </a>
        </template>
      </div>
    </section>

    <section class="hidden space-y-4" data-talk-detail aria-live="polite" aria-busy="false">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button
          class="text-xs uppercase tracking-[0.3em] text-slate-500 transition hover:text-sky-700 dark:text-slate-400 dark:hover:text-sky-200"
          type="button"
          data-talk-back
        >
          Back to topics
        </button>
        <div class="flex flex-wrap gap-2">
          <button
            class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-[0.3em] text-slate-600 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-800/60 dark:text-slate-300 dark:hover:text-sky-200"
            type="button"
            data-talk-copy
          >
            Copy link
          </button>
          <button
            class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-[0.3em] text-slate-600 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-800/60 dark:text-slate-300 dark:hover:text-sky-200"
            type="button"
            data-talk-share
          >
            Share
          </button>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white/80 p-6 dark:border-slate-800/60 dark:bg-slate-900/40">
        <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" data-talk-detail-meta></div>
        <h2 class="mt-3 text-2xl font-semibold text-slate-900 dark:text-slate-100" data-talk-detail-title></h2>
        <p class="mt-3 whitespace-pre-wrap text-sm text-slate-600 dark:text-slate-300" data-talk-detail-body></p>
        <p class="mt-3 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" data-talk-detail-status></p>
      </div>

      <div
        class="hidden rounded-2xl border border-slate-200 bg-white/80 p-6 dark:border-slate-800/60 dark:bg-slate-900/40"
        data-talk-voice
        aria-hidden="true"
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Voice room</p>
            <p class="text-sm text-slate-600 dark:text-slate-300">
              Live audio via Jitsi. Share the link before joining.
            </p>
          </div>
        </div>
        <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800/60">
          <iframe
            class="h-[360px] w-full bg-slate-100 dark:bg-slate-900"
            title="Voice chat"
            allow="microphone; camera; fullscreen; display-capture"
            data-talk-voice-frame
          ></iframe>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white/80 p-6 dark:border-slate-800/60 dark:bg-slate-900/40">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Replies</p>
            <p class="text-sm text-slate-600 dark:text-slate-300">Add a reply or share a link.</p>
          </div>
        </div>
        <form class="mt-4 grid gap-3" data-talk-comment-form>
          <div class="grid gap-3 md:grid-cols-2">
            <div>
              <label class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" for="talk-comment-name">
                Display name (optional)
              </label>
              <input
                id="talk-comment-name"
                name="author_name"
                type="text"
                class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-sky-400 focus:outline-none dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-100"
                placeholder="Anon"
                data-talk-comment-author
              />
            </div>
          </div>
          <div>
            <label class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" for="talk-comment-body">
              Reply
            </label>
            <textarea
              id="talk-comment-body"
              name="body"
              class="mt-2 min-h-[120px] w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-sky-400 focus:outline-none dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-100"
              placeholder="What do you think?"
              data-talk-comment-body
              required
            ></textarea>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs text-slate-500 dark:text-slate-400" data-talk-comment-status></p>
            <button
              type="submit"
              class="rounded-2xl border border-slate-200 bg-slate-100 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-700/60 dark:bg-slate-900/60 dark:text-slate-200 dark:hover:text-sky-200"
              data-talk-comment-submit
            >
              Post reply
            </button>
          </div>
        </form>

        <div class="mt-6 space-y-4" data-talk-comments>
          <div class="hidden text-sm text-slate-600 dark:text-slate-300" data-talk-comments-empty>
            No replies yet.
          </div>
          <div class="hidden space-y-4" data-talk-comments-list></div>
          <template>
            <div class="rounded-2xl border border-slate-200 bg-white/70 p-4 dark:border-slate-800/60 dark:bg-slate-950/40">
              <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" data-comment-meta></div>
              <p class="mt-2 whitespace-pre-wrap text-sm text-slate-600 dark:text-slate-300" data-comment-body></p>
            </div>
          </template>
        </div>
      </div>
    </section>
  </section>

  <script>
    import { initTalkPage } from '../../scripts/content-loader.js';

    initTalkPage();
  </script>
</BaseLayout>
