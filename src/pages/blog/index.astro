---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Blog" description="Personal notes and build logs.">
  <section class="space-y-8">
    <header class="space-y-4">
      <p class="text-xs uppercase tracking-[0.3em] text-sky-700 dark:text-sky-200">Blog</p>
      <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Personal logs and deep dives.</h1>
      <p class="max-w-2xl text-base text-slate-600 dark:text-slate-300">
        Updates, experiments, and the notes behind each build.
      </p>
    </header>

    <div data-blog-list aria-live="polite" aria-busy="false">
      <div class="space-y-4" data-skeleton aria-hidden="true">
        {Array.from({ length: 4 }).map(() => (
          <div class="animate-pulse rounded-2xl border border-slate-200 bg-white/80 px-6 py-5 dark:border-slate-800/60 dark:bg-slate-900/40">
            <div class="h-3 w-24 rounded bg-slate-200 dark:bg-slate-800/80"></div>
            <div class="mt-3 h-4 w-2/3 rounded bg-slate-200 dark:bg-slate-800/80"></div>
            <div class="mt-2 h-3 w-full rounded bg-slate-100 dark:bg-slate-800/60"></div>
          </div>
        ))}
      </div>
      <div class="hidden rounded-2xl border border-slate-200 bg-white/80 px-6 py-8 text-sm text-slate-600 dark:border-slate-800/60 dark:bg-slate-900/40 dark:text-slate-300" data-empty role="status">
        No posts yet. The first entries are on the way.
      </div>
      <div class="hidden rounded-2xl border border-rose-200 bg-rose-50 px-6 py-8 text-sm text-rose-600 dark:border-rose-500/40 dark:bg-rose-500/10 dark:text-rose-200" data-error role="alert">
        Unable to load posts. Check your Supabase configuration.
      </div>
      <div class="hidden divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white/80 dark:divide-slate-800/60 dark:border-slate-800/60 dark:bg-slate-900/40" data-list></div>
      <template>
        <article class="space-y-3 px-6 py-5" aria-label="Blog post summary">
          <p class="text-xs font-mono uppercase tracking-widest text-slate-500 dark:text-slate-500">
            <time data-date></time>
          </p>
          <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">
            <a class="inline-flex min-h-[44px] items-center rounded-lg py-1 transition hover:text-sky-700 dark:hover:text-sky-200 sm:min-h-0" data-link></a>
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-300" data-description></p>
          <div class="mt-3 flex flex-wrap gap-2" data-tags></div>
        </article>
      </template>
    </div>

    <div class="hidden" data-blog-detail aria-live="polite" aria-busy="false">
      <div class="space-y-4" data-skeleton aria-hidden="true">
        <div class="animate-pulse rounded-2xl border border-slate-200 bg-white/80 px-6 py-6 dark:border-slate-800/60 dark:bg-slate-900/40">
          <div class="h-4 w-1/3 rounded bg-slate-200 dark:bg-slate-800/80"></div>
          <div class="mt-4 h-6 w-2/3 rounded bg-slate-200 dark:bg-slate-800/80"></div>
          <div class="mt-3 h-3 w-full rounded bg-slate-100 dark:bg-slate-800/60"></div>
        </div>
      </div>
      <div class="hidden rounded-2xl border border-rose-200 bg-rose-50 px-6 py-8 text-sm text-rose-600 dark:border-rose-500/40 dark:bg-rose-500/10 dark:text-rose-200" data-error role="alert">
        Unable to load this post.
      </div>
      <article class="hidden space-y-3 md:space-y-4" data-detail aria-label="Blog post detail">
        <a class="text-xs uppercase tracking-[0.3em] text-slate-500 transition hover:text-sky-700 dark:text-slate-400 dark:hover:text-sky-200" href={`${baseUrl}blog/`}>
          Back to blog
        </a>
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-100 sm:text-4xl" data-detail-title></h1>
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400 sm:text-sm">
          <time data-detail-date></time>
          <span
            class="hidden rounded-full border border-sky-200 bg-sky-50 px-2.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-sky-700 dark:border-sky-500/40 dark:bg-sky-500/10 dark:text-sky-200"
            data-detail-preview
            aria-hidden="true"
          >
            Preview
          </span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-300 sm:text-[0.95rem]" data-detail-description></p>
        <img
          class="hidden mx-auto max-h-48 w-full max-w-2xl rounded-xl border border-slate-200 bg-white/80 object-cover object-center shadow-sm dark:border-slate-800/60 dark:bg-slate-900/40 sm:max-h-52 md:max-h-56"
          data-detail-cover
          loading="lazy"
          decoding="async"
        />
        <div class="flex flex-wrap gap-1.5 sm:gap-2" data-detail-tags></div>
        <div
          class="blog-post-content prose prose-sm max-w-none text-slate-700 prose-p:leading-relaxed prose-img:mx-auto prose-img:rounded-xl dark:prose-invert prose-pre:text-xs sm:prose-pre:text-sm"
          data-detail-content
        ></div>
        <div class="mt-6 border-t border-slate-200/80 pt-5 dark:border-slate-800/60 sm:mt-8 sm:pt-6" data-related>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Related</p>
            <a class="text-xs uppercase tracking-[0.3em] text-slate-500 transition hover:text-sky-700 dark:text-slate-400 dark:hover:text-sky-200" href={`${baseUrl}search/`}>
              Browse more
            </a>
          </div>
          <p class="mt-3 hidden text-sm text-slate-500 dark:text-slate-400" data-related-loading>
            Loading related…
          </p>
          <p class="mt-3 hidden text-sm text-slate-600 dark:text-slate-300" data-related-empty>
            No related entries yet.
          </p>
          <div class="mt-3 grid gap-3 md:grid-cols-2" data-related-list></div>
          <template>
            <article class="rounded-2xl border border-slate-200 bg-white/80 p-3 dark:border-slate-800/60 dark:bg-slate-900/40">
              <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" data-related-type></p>
              <h3 class="mt-1.5 text-base font-semibold text-slate-900 dark:text-slate-100">
                <a class="transition hover:text-sky-700 dark:hover:text-sky-200" data-related-link></a>
              </h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-300" data-related-description></p>
              <div class="mt-3 flex flex-wrap gap-2" data-related-tags></div>
            </article>
          </template>
        </div>

        <p class="mt-6 hidden border-t border-slate-200/80 pt-5 text-sm text-slate-600 dark:border-slate-800/60 dark:text-slate-300 sm:mt-8 sm:pt-6" data-blog-comments-preview>
          Comments appear once this post is published.
        </p>

        <div class="mt-6 border-t border-slate-200/80 pt-5 dark:border-slate-800/60 sm:mt-8 sm:pt-6" data-blog-comments-published>
          <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Comments</p>
          <p class="mt-3 hidden text-sm text-slate-500 dark:text-slate-400" data-blog-comments-loading>
            Loading comments…
          </p>
          <p class="mt-3 hidden text-sm text-slate-600 dark:text-slate-300" data-blog-comments-empty>
            No comments yet. Be the first to reply.
          </p>
          <div class="mt-3 space-y-3" data-blog-comments-list></div>
          <template data-blog-comments-template>
            <article class="rounded-2xl border border-slate-200 bg-white/80 p-3 dark:border-slate-800/60 dark:bg-slate-900/40">
              <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" data-comment-meta></p>
              <p class="mt-1.5 whitespace-pre-wrap text-sm text-slate-600 dark:text-slate-300" data-comment-body></p>
            </article>
          </template>

          <form class="mt-4 grid gap-2.5" data-blog-comment-form>
            <div>
              <label class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" for="blog-comment-name">Name (optional)</label>
              <input
                id="blog-comment-name"
                name="author"
                type="text"
                maxlength="40"
                class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm text-slate-900 shadow-sm focus:border-sky-400 focus:outline-none dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-100"
                data-blog-comment-author
              />
            </div>
            <div>
              <label class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" for="blog-comment-body">Comment</label>
              <textarea
                id="blog-comment-body"
                name="body"
                rows="4"
                required
                minlength="3"
                maxlength="3000"
                class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-sky-400 focus:outline-none dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-100"
                data-blog-comment-body
              ></textarea>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <button
                type="submit"
                class="rounded-full bg-sky-100 px-5 py-2 text-sm font-semibold text-sky-800 transition hover:bg-sky-200 dark:bg-sky-400/15 dark:text-sky-200 dark:hover:bg-sky-400/25"
                data-blog-comment-submit
              >
                Post comment
              </button>
              <p class="text-xs text-slate-500 dark:text-slate-400" data-blog-comment-status role="status"></p>
            </div>
          </form>
        </div>
      </article>
    </div>
  </section>

  <script>
    import { initBlogPage } from '../../scripts/content-loader.js';

    initBlogPage();
  </script>
</BaseLayout>
