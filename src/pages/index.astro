---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Emad Dev Blog"
  description="Personal blog posts and curated links from the build desk."
>
  <section class="grid items-start gap-10 md:grid-cols-[1.05fr_0.95fr]">
    <div class="space-y-6 animate-fade-up">
      <p class="text-xs uppercase tracking-[0.3em] text-sky-700 dark:text-sky-200">News + Blog</p>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl">
        Personal notes and curated links, kept in rhythm.
      </h1>
      <p class="max-w-xl text-base text-slate-600 dark:text-slate-300">
        Short updates between deeper posts, plus links that shape what ships next.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          class="rounded-full bg-sky-100 px-5 py-2 text-sm font-semibold text-sky-800 transition hover:bg-sky-200 dark:bg-sky-400/15 dark:text-sky-200 dark:hover:bg-sky-400/25"
          href={`${baseUrl}blog/`}
        >
          Read recent posts
        </a>
        <a
          class="rounded-full border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-700 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-700/60 dark:text-slate-200 dark:hover:text-sky-200"
          href={`${baseUrl}projects/`}
        >
          Browse projects
        </a>
      </div>
    </div>

    <div class="animate-fade-up-delayed space-y-6">
      <div class="rounded-3xl border border-slate-200 bg-white/80 p-6 dark:border-slate-800/60 dark:bg-slate-900/40">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Featured posts</p>
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="hidden text-[0.65rem] uppercase tracking-[0.3em] text-slate-400 dark:text-slate-500"
              data-home-updated="posts"
              aria-hidden="true"
            ></span>
          </div>
        </div>
        <div class="mt-4 space-y-4" data-home-posts aria-live="polite" aria-busy="false">
          <div class="space-y-4" data-skeleton aria-hidden="true">
            {Array.from({ length: 3 }).map(() => (
              <div class="animate-pulse rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800/60 dark:bg-slate-950/40">
                <div class="h-3 w-24 rounded bg-slate-200 dark:bg-slate-800/80"></div>
                <div class="mt-3 h-4 w-3/4 rounded bg-slate-200 dark:bg-slate-800/80"></div>
                <div class="mt-2 h-3 w-full rounded bg-slate-100 dark:bg-slate-800/60"></div>
              </div>
            ))}
          </div>
          <p class="hidden text-sm text-slate-600 dark:text-slate-300" data-empty role="status">
            No featured posts yet.{' '}
            <a class="font-medium text-sky-700 underline decoration-sky-400/50 hover:text-sky-800 dark:text-sky-300 dark:hover:text-sky-200" href={`${baseUrl}blog/`}>
              Browse all posts
            </a>
            .
          </p>
          <p class="hidden text-sm text-rose-600 dark:text-rose-300" data-error role="alert">
            Unable to load posts. Check your Supabase configuration.
          </p>
          <div class="hidden space-y-4" data-list></div>
          <template>
            <article class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800/60 dark:bg-slate-950/40" aria-label="Blog post preview">
              <p class="text-xs font-mono uppercase tracking-widest text-slate-500 dark:text-slate-500">
                <time data-date></time>
              </p>
              <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">
                <a class="inline-flex min-h-[44px] items-center rounded-lg py-1 transition hover:text-sky-700 dark:hover:text-sky-200 sm:min-h-0" data-link></a>
              </h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-300" data-description></p>
            </article>
          </template>
        </div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white/80 p-6 dark:border-slate-800/60 dark:bg-slate-900/40">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Curated news</p>
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="hidden text-[0.65rem] uppercase tracking-[0.3em] text-slate-400 dark:text-slate-500"
              data-home-updated="news"
              aria-hidden="true"
            ></span>
          </div>
        </div>
        <div class="mt-4 space-y-3" data-home-news aria-live="polite" aria-busy="false">
          <div class="space-y-3" data-skeleton aria-hidden="true">
            {Array.from({ length: 3 }).map(() => (
              <div class="animate-pulse rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800/60 dark:bg-slate-950/40">
                <div class="flex gap-3">
                  <div class="min-h-[4rem] flex-1 space-y-2">
                    <div class="flex justify-between gap-2">
                      <div class="h-3 w-24 rounded bg-slate-200 dark:bg-slate-800/80"></div>
                      <div class="h-3 w-16 rounded bg-slate-200 dark:bg-slate-800/80"></div>
                    </div>
                    <div class="h-4 w-3/4 rounded bg-slate-200 dark:bg-slate-800/80"></div>
                    <div class="h-3 w-full rounded bg-slate-100 dark:bg-slate-800/60"></div>
                  </div>
                  <div class="h-14 w-11 shrink-0 rounded-xl bg-slate-100 dark:bg-slate-800/60"></div>
                </div>
              </div>
            ))}
          </div>
          <p class="hidden text-sm text-slate-600 dark:text-slate-300" data-empty role="status">
            No pinned news yet.{' '}
            <a class="font-medium text-sky-700 underline decoration-sky-400/50 hover:text-sky-800 dark:text-sky-300 dark:hover:text-sky-200" href={`${baseUrl}news/`}>
              Browse all news
            </a>
            .
          </p>
          <p class="hidden text-sm text-rose-600 dark:text-rose-300" data-error role="alert">
            Unable to load news. Check your Supabase configuration.
          </p>
          <div class="hidden space-y-3" data-list></div>
          <template>
            <article class="flex gap-2 rounded-2xl border border-slate-200 bg-white/80 p-3 dark:border-slate-800/60 dark:bg-slate-950/40 sm:gap-3">
              <a
                class="min-w-0 flex-1 rounded-xl px-1 py-0.5 outline-none ring-sky-400/40 transition hover:bg-slate-50/90 focus-visible:ring-2 dark:hover:bg-slate-900/50"
                data-news-link
                href="#"
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="flex flex-wrap items-center justify-between gap-2 text-[0.65rem] uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
                  <span class="flex flex-wrap items-center gap-1.5">
                    <span data-source></span>
                    <span
                      class="hidden rounded-full border border-violet-200 bg-violet-50 px-2 py-0.5 text-[0.55rem] font-semibold normal-case tracking-[0.12em] text-violet-800 dark:border-violet-500/40 dark:bg-violet-500/15 dark:text-violet-200"
                      data-auto-badge
                    ></span>
                  </span>
                  <div class="flex flex-wrap items-center justify-end gap-x-3 gap-y-1 text-right">
                    <div class="flex flex-col items-end gap-0.5 sm:flex-row sm:items-baseline sm:gap-2">
                      <span class="text-[0.6rem] text-slate-400 dark:text-slate-500">Published</span>
                      <time
                        class="font-mono text-[0.7rem] tabular-nums normal-case tracking-normal text-slate-600 dark:text-slate-300"
                        data-date
                      ></time>
                    </div>
                    <div class="flex flex-wrap items-center justify-end gap-2 font-mono normal-case tracking-normal text-slate-500 dark:text-slate-400" data-meta></div>
                  </div>
                </div>
                <div class="mt-2 flex items-start justify-between gap-2">
                  <h3 class="line-clamp-2 flex-1 text-left text-base font-semibold leading-snug text-slate-900 dark:text-slate-100" data-title></h3>
                  <span class="hidden shrink-0 rounded-full bg-sky-100 px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-[0.15em] text-sky-700 dark:bg-sky-500/20 dark:text-sky-200" data-pinned>
                    Pinned
                  </span>
                </div>
                <p class="mt-1 line-clamp-2 text-left text-sm text-slate-600 dark:text-slate-300" data-summary></p>
                <div class="mt-2 flex flex-wrap gap-1.5" data-tags></div>
              </a>
              <div class="flex shrink-0 flex-col justify-start pt-0.5">
                <button
                  type="button"
                  class="inline-flex min-h-[44px] min-w-[44px] flex-col items-center justify-center gap-0.5 rounded-xl border border-slate-200 bg-white px-2 text-[0.7rem] font-semibold tabular-nums text-slate-600 transition hover:border-sky-400/60 hover:text-sky-700 disabled:opacity-50 dark:border-slate-700/60 dark:bg-slate-900/50 dark:text-slate-300 md:min-h-[2.25rem] md:min-w-[2.25rem]"
                  data-news-vote
                  aria-label="Upvote story"
                  aria-pressed="false"
                >
                  <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 5 5 13h14L12 5Z" />
                  </svg>
                  <span data-vote-count>0</span>
                </button>
              </div>
            </article>
          </template>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-16 space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-2">
        <p class="text-xs uppercase tracking-[0.3em] text-sky-700 dark:text-sky-200">Projects</p>
        <h2 class="text-2xl font-semibold">GitHub work in progress</h2>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <span
          class="hidden text-[0.65rem] uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400"
          data-home-updated="projects"
          aria-hidden="true"
        ></span>
        <a class="text-sm text-slate-600 transition hover:text-sky-700 dark:text-slate-300 dark:hover:text-sky-200" href={`${baseUrl}projects/`}>
          Browse all projects
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2" data-home-projects aria-live="polite" aria-busy="false">
      <div class="col-span-full grid grid-cols-1 gap-6 md:grid-cols-2" data-skeleton aria-hidden="true">
        {Array.from({ length: 3 }).map(() => (
          <div class="animate-pulse rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800/60 dark:bg-slate-950/40">
            <div class="h-4 w-2/3 rounded bg-slate-200 dark:bg-slate-800/80"></div>
            <div class="mt-3 h-3 w-full rounded bg-slate-100 dark:bg-slate-800/60"></div>
            <div class="mt-2 h-3 w-5/6 rounded bg-slate-100 dark:bg-slate-800/60"></div>
          </div>
        ))}
      </div>
      <p class="hidden text-sm text-slate-600 dark:text-slate-300" data-empty role="status">
        No projects yet.
      </p>
      <p class="hidden text-sm text-rose-600 dark:text-rose-300" data-error role="alert">
        Unable to load projects. Check your Supabase configuration.
      </p>
      <div class="hidden grid grid-cols-1 gap-6 md:grid-cols-2" data-list></div>
      <template>
        <a
          class="group flex h-full flex-col justify-between rounded-2xl border border-slate-200 bg-white/80 p-6 transition hover:-translate-y-1 hover:border-sky-400/60 hover:bg-slate-100/70 hover:shadow-[0_20px_40px_-20px_rgba(56,189,248,0.45)] dark:border-slate-800/60 dark:bg-slate-900/40 dark:hover:bg-slate-900/70"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open project link"
        >
          <div>
            <div class="flex items-start justify-between gap-4">
              <h3 class="min-w-0 flex-1 break-words text-lg font-semibold leading-snug text-slate-900 dark:text-slate-100" data-title></h3>
              <svg
                class="h-4 w-4 shrink-0 text-slate-500 transition group-hover:text-sky-200 dark:text-slate-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 3h7v7" />
                <path d="M10 14 21 3" />
                <path d="M21 14v7h-7" />
                <path d="M3 10v11h11" />
              </svg>
            </div>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300" data-description></p>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400" data-meta></div>
          <div class="mt-3 flex flex-wrap gap-2" data-tags></div>
        </a>
      </template>
    </div>
  </section>

  <script>
    import { initHome } from '../scripts/content-loader.js';

    initHome();
  </script>
</BaseLayout>
