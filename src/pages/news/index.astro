---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="News" description="Curated news links and release highlights.">
  <section class="space-y-8">
    <header class="space-y-4">
      <p class="text-xs uppercase tracking-[0.3em] text-sky-700 dark:text-sky-200">News</p>
      <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">
        Curated links worth revisiting.
      </h1>
      <p class="max-w-2xl text-base text-slate-600 dark:text-slate-300">
        A running list of articles and references that influence current work.
      </p>
    </header>

    <div data-news-page aria-live="polite" aria-busy="false">
      <div class="grid gap-6 md:grid-cols-2" data-skeleton aria-hidden="true">
        {Array.from({ length: 4 }).map(() => (
          <div class="animate-pulse rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-slate-800/60 dark:bg-slate-950/40">
            <div class="flex items-center justify-between">
              <div class="h-3 w-24 rounded bg-slate-200 dark:bg-slate-800/80"></div>
              <div class="h-3 w-16 rounded bg-slate-200 dark:bg-slate-800/80"></div>
            </div>
            <div class="mt-3 h-4 w-3/4 rounded bg-slate-200 dark:bg-slate-800/80"></div>
            <div class="mt-2 h-3 w-full rounded bg-slate-100 dark:bg-slate-800/60"></div>
          </div>
        ))}
      </div>
      <div class="hidden rounded-2xl border border-slate-200 bg-white/80 px-6 py-8 text-sm text-slate-600 dark:border-slate-800/60 dark:bg-slate-900/40 dark:text-slate-300" data-empty role="status">
        No curated links yet.
      </div>
      <div class="hidden rounded-2xl border border-rose-200 bg-rose-50 px-6 py-8 text-sm text-rose-600 dark:border-rose-500/40 dark:bg-rose-500/10 dark:text-rose-200" data-error role="alert">
        Unable to load news. Check your Supabase configuration.
      </div>
      <div class="hidden grid gap-6 md:grid-cols-2" data-list></div>
      <template>
        <a
          class="block rounded-2xl border border-slate-200 bg-white/80 p-4 transition hover:border-sky-400/60 hover:bg-slate-100 dark:border-slate-800/60 dark:bg-slate-950/40 dark:hover:bg-slate-900/60"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open curated news link"
        >
          <div class="flex flex-wrap items-center justify-between gap-2 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
            <span data-source></span>
            <div class="flex flex-wrap items-center gap-3" data-meta>
              <time data-date></time>
            </div>
          </div>
          <div class="mt-3 flex items-start justify-between gap-3">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100" data-title></h3>
            <span class="hidden rounded-full bg-sky-100 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-sky-700 dark:bg-sky-500/20 dark:text-sky-200" data-pinned>
              Pinned
            </span>
          </div>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300" data-summary></p>
          <div class="mt-3 flex flex-wrap gap-2" data-tags></div>
        </a>
      </template>
    </div>
  </section>

  <script>
    import { initNewsPage } from '../../scripts/content-loader.js';

    initNewsPage();
  </script>
</BaseLayout>
