---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects" description="Selected GitHub repos and experiments.">
  <section class="space-y-8">
    <header class="space-y-4">
      <p class="text-xs uppercase tracking-[0.3em] text-sky-700 dark:text-sky-200">Projects</p>
      <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Shipping and sharing.</h1>
      <p class="max-w-2xl text-base text-slate-600 dark:text-slate-300">
        Highlighting repos with build notes, metadata, and links you can safely explore.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-projects-page aria-live="polite" aria-busy="false">
      <div class="col-span-full grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-skeleton aria-hidden="true">
        {Array.from({ length: 6 }).map(() => (
          <div class="animate-pulse rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800/60 dark:bg-slate-950/40">
            <div class="h-4 w-2/3 rounded bg-slate-200 dark:bg-slate-800/80"></div>
            <div class="mt-3 h-3 w-full rounded bg-slate-100 dark:bg-slate-800/60"></div>
            <div class="mt-2 h-3 w-5/6 rounded bg-slate-100 dark:bg-slate-800/60"></div>
          </div>
        ))}
      </div>
      <p class="hidden text-sm text-slate-600 dark:text-slate-300" data-empty role="status">
        No projects yet.
      </p>
      <p class="hidden text-sm text-rose-600 dark:text-rose-300" data-error role="alert">
        Unable to load projects. Check your Supabase configuration.
      </p>
      <div class="hidden grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-list></div>
      <template>
        <a
          class="group flex h-full flex-col justify-between rounded-2xl border border-slate-200 bg-white/80 p-6 transition hover:-translate-y-1 hover:border-sky-400/60 hover:bg-slate-100/70 hover:shadow-[0_20px_40px_-20px_rgba(56,189,248,0.45)] dark:border-slate-800/60 dark:bg-slate-900/40 dark:hover:bg-slate-900/70"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open project link"
        >
          <div>
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100" data-title></h3>
              <svg
                class="h-4 w-4 text-slate-500 transition group-hover:text-sky-200 dark:text-slate-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 3h7v7" />
                <path d="M10 14 21 3" />
                <path d="M21 14v7h-7" />
                <path d="M3 10v11h11" />
              </svg>
            </div>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300" data-description></p>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400" data-meta></div>
          <div class="mt-3 flex flex-wrap gap-2" data-tags></div>
        </a>
      </template>
    </div>
  </section>

  <script>
    import { initProjectsPage } from '../../scripts/content-loader.js';

    initProjectsPage();
  </script>
</BaseLayout>
