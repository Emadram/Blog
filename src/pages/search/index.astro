---
import BaseLayout from '../../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Search" description="Search posts, news, and projects.">
  <section class="space-y-8" data-search-page>
    <header class="space-y-4">
      <p class="text-xs uppercase tracking-[0.3em] text-sky-700 dark:text-sky-200">Search</p>
      <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Find stories, links, and projects.</h1>
      <p class="max-w-2xl text-base text-slate-600 dark:text-slate-300">
        Search across posts, news, and project updates.
      </p>
    </header>

    <form class="flex flex-col gap-3 md:flex-row" method="get" action={`${baseUrl}search/`}>
      <label class="sr-only" for="search-input">Search the site</label>
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="Search posts, news, and projects..."
        class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm focus:border-sky-400 focus:outline-none dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-100 dark:placeholder:text-slate-500"
        data-search-input
      />
      <button
        type="submit"
        class="rounded-2xl border border-slate-200 bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-700/60 dark:bg-slate-900/60 dark:text-slate-200 dark:hover:text-sky-200"
      >
        Search
      </button>
    </form>

    <div class="flex flex-wrap gap-2" role="tablist" aria-label="Search filters">
      <button class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-[0.3em] text-slate-600 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-800/60 dark:text-slate-300 dark:hover:text-sky-200" type="button" data-search-filter="all" aria-pressed="true">
        All
      </button>
      <button class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-[0.3em] text-slate-600 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-800/60 dark:text-slate-300 dark:hover:text-sky-200" type="button" data-search-filter="post" aria-pressed="false">
        Posts
      </button>
      <button class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-[0.3em] text-slate-600 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-800/60 dark:text-slate-300 dark:hover:text-sky-200" type="button" data-search-filter="news" aria-pressed="false">
        News
      </button>
      <button class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-[0.3em] text-slate-600 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-800/60 dark:text-slate-300 dark:hover:text-sky-200" type="button" data-search-filter="project" aria-pressed="false">
        Projects
      </button>
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-300" data-search-summary></p>

    <section
      class="rounded-2xl border border-slate-200 bg-white/80 p-5 dark:border-slate-800/60 dark:bg-slate-900/40"
      data-search-ai
      data-search-ai-disabled
      aria-disabled="true"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="space-y-1">
          <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Search AI</p>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Ask the site</h2>
          <p class="text-sm text-slate-600 dark:text-slate-300">
            Temporarily unavailable.
          </p>
        </div>
        <span class="flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-rose-600 dark:text-rose-300">
          <span class="relative inline-flex h-2 w-2 rounded-full bg-rose-500"></span>
          Down
        </span>
      </div>

      <div class="mt-4 grid gap-4 md:grid-cols-[1.2fr_0.8fr]">
        <div class="space-y-3">
          <label
            class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400"
            for="search-ai-input"
          >
            Question
          </label>
          <textarea
            id="search-ai-input"
            class="min-h-[120px] w-full cursor-not-allowed rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 opacity-60 shadow-sm focus:border-sky-400 focus:outline-none dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-100"
            placeholder="Search AI is currently unavailable."
            data-search-ai-input
            aria-disabled="true"
            disabled
          ></textarea>
          <div class="flex flex-wrap gap-2">
            <button
              class="cursor-not-allowed rounded-2xl border border-slate-200 bg-slate-100 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700 opacity-60 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-700/60 dark:bg-slate-900/60 dark:text-slate-200 dark:hover:text-sky-200"
              type="button"
              data-search-ai-run
              aria-disabled="true"
              disabled
            >
              Ask AI
            </button>
            <button
              class="cursor-not-allowed rounded-2xl border border-slate-200 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-600 opacity-60 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-700/60 dark:bg-slate-950/40 dark:text-slate-300 dark:hover:text-sky-200"
              type="button"
              data-search-ai-clear
              aria-disabled="true"
              disabled
            >
              Clear
            </button>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400" data-search-ai-status>
            Search AI is temporarily unavailable.
          </p>
        </div>

        <div class="space-y-3 rounded-2xl border border-slate-200 bg-white/70 p-4 text-sm text-slate-600 dark:border-slate-800/60 dark:bg-slate-950/40 dark:text-slate-300">
          <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Status</p>
          <p>Search AI is currently offline.</p>
          <p>No requests are sent while it is unavailable.</p>
          <p>Check back later for updates.</p>
        </div>
      </div>

      <div
        class="mt-4 hidden rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-slate-800/60 dark:bg-slate-950/40"
        data-search-ai-card
        role="status"
        aria-live="polite"
      >
        <div
          class="prose max-w-none text-sm text-slate-700 dark:prose-invert dark:text-slate-200"
          data-search-ai-response
        ></div>
        <div
          class="mt-4 border-t border-slate-200 pt-3 text-xs text-slate-600 dark:border-slate-800/60 dark:text-slate-300"
          data-search-ai-sources
        ></div>
      </div>
    </section>

    <div class="space-y-4" data-search-results aria-live="polite" aria-busy="false">
      <div class="space-y-4" data-skeleton aria-hidden="true">
        {Array.from({ length: 4 }).map(() => (
          <div class="animate-pulse rounded-2xl border border-slate-200 bg-white/80 px-6 py-5 dark:border-slate-800/60 dark:bg-slate-900/40">
            <div class="h-3 w-24 rounded bg-slate-200 dark:bg-slate-800/80"></div>
            <div class="mt-3 h-4 w-2/3 rounded bg-slate-200 dark:bg-slate-800/80"></div>
            <div class="mt-2 h-3 w-full rounded bg-slate-100 dark:bg-slate-800/60"></div>
          </div>
        ))}
      </div>
      <p class="hidden text-sm text-slate-600 dark:text-slate-300" data-empty role="status">
        Enter a keyword to search.
      </p>
      <p class="hidden text-sm text-rose-600 dark:text-rose-300" data-error role="alert">
        Unable to run search. Check your Supabase configuration.
      </p>
      <div class="hidden space-y-4" data-list></div>
      <template>
        <article class="rounded-2xl border border-slate-200 bg-white/80 px-6 py-5 dark:border-slate-800/60 dark:bg-slate-900/40">
          <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400" data-meta>
            <span data-type></span>
            <span data-date></span>
          </div>
          <h2 class="mt-3 text-xl font-semibold text-slate-900 dark:text-slate-100">
            <a class="transition hover:text-sky-700 dark:hover:text-sky-200" data-title-link></a>
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300" data-description></p>
          <div class="mt-3 flex flex-wrap gap-2" data-tags></div>
        </article>
      </template>
    </div>
  </section>

  <script>
    import { initSearchPage } from '../../scripts/content-loader.js';

    initSearchPage();
  </script>
</BaseLayout>
