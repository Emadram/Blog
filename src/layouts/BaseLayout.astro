---
import '../styles/global.css';

const {
  title = 'Emad Dev Blog',
  description = 'Notes, experiments, and project write-ups from the build desk.',
  image = '/og-default.svg',
  type = 'website',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? 'emadram.github.io';
const enableAnalytics = import.meta.env.PROD && plausibleDomain;
const enableServiceWorker = import.meta.env.PROD;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const canonicalUrl = (Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url).toString();
const imagePath = image.startsWith('http') ? image : `${baseUrl}${image.replace(/^\//, '')}`;
const imageUrl = imagePath.startsWith('http')
  ? imagePath
  : new URL(imagePath, Astro.site ?? Astro.url).toString();

const normalizePath = (value) => {
  if (!value) {
    return '/';
  }
  const trimmed = value.replace(/\/+$/, '/') || '/';
  return trimmed.startsWith('/') ? trimmed : `/${trimmed}`;
};

const getNavPath = (href) => {
  try {
    return new URL(href, Astro.site ?? Astro.url).pathname;
  } catch (error) {
    return href;
  }
};

const currentPath = normalizePath(Astro.url?.pathname ?? '/');
const rawNavItems = [
  { label: 'Home', href: baseUrl },
  { label: 'Search', href: `${baseUrl}search/` },
  { label: 'Blog', href: `${baseUrl}blog/` },
  { label: 'News', href: `${baseUrl}news/` },
  { label: 'About', href: `${baseUrl}about/` },
  { label: 'Projects', href: `${baseUrl}projects/` },
];

const navItems = rawNavItems.map((item) => {
  const path = normalizePath(getNavPath(item.href));
  return {
    ...item,
    isActive: currentPath === path,
  };
});

const rawBottomNavItems = [
  { label: 'Projects', href: `${baseUrl}projects/`, icon: 'projects' },
  { label: 'Blog', href: `${baseUrl}blog/`, icon: 'blog' },
  { label: 'Home', href: baseUrl, icon: 'home' },
  { label: 'News', href: `${baseUrl}news/`, icon: 'news' },
  { label: 'Search', href: `${baseUrl}search/`, icon: 'search' },
];

const bottomNavItems = rawBottomNavItems.map((item) => {
  const path = normalizePath(getNavPath(item.href));
  return {
    ...item,
    isActive: currentPath === path,
  };
});

const linkClass =
  'rounded-lg px-2 py-1 transition hover:text-sky-700 dark:hover:text-sky-200 md:inline-flex md:items-center';
const mobileLinkClass =
  'block rounded-lg px-3 py-3 text-base transition hover:bg-slate-100 hover:text-sky-700 dark:hover:bg-slate-800/80 dark:hover:text-sky-200';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={`${baseUrl}favicon_blog/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon_blog/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl}favicon_blog/favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}favicon_blog/apple-touch-icon.png`} />
    <link rel="manifest" href={`${baseUrl}manifest.webmanifest`} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="application-name" content="Emad Dev Blog" />
    <meta name="apple-mobile-web-app-title" content="Emad Dev Blog" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#020617" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Emad Dev Blog" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Emad Dev Blog"
      href={`${baseUrl}rss.xml`}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap"
      />
    </noscript>
    {enableAnalytics && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
    <script is:inline>
      (() => {
        const storageKey = 'emad-theme';
        const root = document.documentElement;

        const getStoredTheme = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        };

        const getPreferredTheme = () => {
          const stored = getStoredTheme();
          if (stored === 'light' || stored === 'dark') {
            return stored;
          }

          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
          }

          return 'light';
        };

        const syncThemeButtons = (theme) => {
          document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
            toggle.setAttribute('aria-pressed', theme === 'dark');
            toggle.setAttribute(
              'aria-label',
              theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
            );
          });
        };

        const applyTheme = (theme) => {
          root.classList.toggle('dark', theme === 'dark');
          root.dataset.theme = theme;
          syncThemeButtons(theme);
        };

        applyTheme(getPreferredTheme());

        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
            toggle.addEventListener('click', () => {
              const next = root.classList.contains('dark') ? 'light' : 'dark';
              try {
                localStorage.setItem(storageKey, next);
              } catch (error) {
                // Ignore storage errors and still apply the theme.
              }
              applyTheme(next);
            });
          });
        });

        const mediaQuery = window.matchMedia
          ? window.matchMedia('(prefers-color-scheme: dark)')
          : null;

        if (mediaQuery) {
          const handleChange = (event) => {
            try {
              if (localStorage.getItem(storageKey)) {
                return;
              }
            } catch (error) {
              // Fall back to system preference.
            }

            applyTheme(event.matches ? 'dark' : 'light');
          };

          if (typeof mediaQuery.addEventListener === 'function') {
            mediaQuery.addEventListener('change', handleChange);
          } else if (typeof mediaQuery.addListener === 'function') {
            mediaQuery.addListener(handleChange);
          }
        }
      })();
    </script>
    <script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
      (() => {
        if (!supabaseUrl || !supabaseKey) {
          return;
        }

        const path = window.location.pathname || '/';
        if (path.includes('/admin')) {
          return;
        }

        try {
          const storageKey = `emad-visit:${path}`;
          if (sessionStorage.getItem(storageKey)) {
            return;
          }
          sessionStorage.setItem(storageKey, '1');
        } catch (error) {
          // Ignore storage errors.
        }

        fetch(`${supabaseUrl}/functions/v1/visit-log`, {
          method: 'POST',
          headers: {
            apikey: supabaseKey,
            Authorization: `Bearer ${supabaseKey}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            path,
            referrer: document.referrer || null,
          }),
          keepalive: true,
        }).catch(() => {});
      })();
    </script>
  </head>
  <body class="selection:bg-sky-300/20 selection:text-slate-900 dark:selection:text-sky-100">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 rounded-lg bg-white px-3 py-2 text-sm text-slate-900 shadow-md ring-2 ring-sky-500 dark:bg-slate-900 dark:text-slate-100"
    >
      Skip to content
    </a>
    <div class="relative min-h-screen overflow-x-hidden bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <!-- Blobs use blur only from md up; phones rely on the radial wash only (cheaper scrolling). -->
        <div class="absolute -top-48 left-1/2 hidden h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-sky-400/25 dark:bg-sky-500/20 md:block md:bg-sky-400/20 md:blur-[120px] md:dark:bg-sky-500/15"></div>
        <div class="absolute bottom-0 right-0 hidden h-[24rem] w-[24rem] translate-x-1/3 translate-y-1/3 rounded-full bg-blue-300/25 dark:bg-blue-400/15 md:block md:bg-blue-300/20 md:blur-[120px] md:dark:bg-blue-400/10"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(226,232,240,0.9),_transparent_65%)] dark:bg-[radial-gradient(circle_at_top,_rgba(15,23,42,0.65),_transparent_58%)] md:bg-[radial-gradient(circle_at_top,_rgba(226,232,240,0.8),_transparent_60%)] md:dark:bg-[radial-gradient(circle_at_top,_rgba(15,23,42,0.6),_transparent_55%)]"></div>
      </div>

      <header class="relative border-b border-slate-200/80 dark:border-slate-800/60">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-safe pt-safe-top pb-5 sm:px-safe-sm md:py-8">
          <a href={baseUrl} class="min-w-0 shrink text-lg font-semibold tracking-tight">Emad Dev Blog</a>

          <nav
            class="hidden flex-wrap items-center gap-3 text-sm text-slate-600 dark:text-slate-300 md:flex"
            aria-label="Primary"
          >
            {navItems.map((item) => (
              <a
                class:list={[
                  linkClass,
                  item.isActive && 'text-sky-700 dark:text-sky-200 font-semibold',
                ]}
                href={item.href}
                aria-current={item.isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
            <button
              type="button"
              class="inline-flex items-center gap-2 rounded-full border border-slate-300/70 px-3 py-2 text-slate-700 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-700/60 dark:text-slate-200 dark:hover:text-sky-200 min-h-[44px] sm:min-h-0 sm:py-1"
              data-theme-toggle
              aria-pressed="false"
              aria-label="Toggle color mode"
            >
              <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2" />
                <path d="M12 20v2" />
                <path d="M4.93 4.93 6.34 6.34" />
                <path d="M17.66 17.66 19.07 19.07" />
                <path d="M2 12h2" />
                <path d="M20 12h2" />
                <path d="M4.93 19.07 6.34 17.66" />
                <path d="M17.66 6.34 19.07 4.93" />
              </svg>
              <svg class="hidden h-4 w-4 dark:inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z" />
              </svg>
              <span class="sr-only">Theme</span>
            </button>
            <a
              class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-slate-300/70 px-3 py-2 text-slate-700 transition hover:border-sky-400/60 hover:text-sky-700 dark:border-slate-700/60 dark:text-slate-200 dark:hover:text-sky-200 sm:min-h-0 sm:py-1"
              href="https://github.com/Emadram"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
              <span class="text-xs text-slate-500 dark:text-slate-400">-></span>
            </a>
          </nav>

        </div>
      </header>

      <main
        id="main-content"
        class="relative mx-auto w-full max-w-6xl px-safe pb-safe-main pt-8 sm:px-safe-sm sm:pt-10"
      >
        <slot />
      </main>

      <footer class="relative hidden border-t border-slate-200/80 dark:border-slate-800/60 md:block">
        <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-3 px-safe py-safe-footer text-sm text-slate-500 dark:text-slate-400 sm:px-safe-sm md:flex-row md:items-center">
          <span>Built with Astro + Tailwind.</span>
          <span class="font-mono text-xs text-slate-500 dark:text-slate-500">Deploying on GitHub Pages.</span>
        </div>
      </footer>

      <nav
        class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200/80 bg-white/95 backdrop-blur dark:border-slate-800/60 dark:bg-slate-950/90 md:hidden"
        aria-label="Primary"
      >
        <div class="mx-auto flex max-w-6xl items-center justify-around px-safe pt-2 pb-safe-bottom">
          {bottomNavItems.map((item) => (
            <a
              class:list={[
                'flex min-w-[3.5rem] flex-1 flex-col items-center gap-1 rounded-xl px-1.5 py-2 text-[0.65rem] font-semibold text-slate-500 transition',
                'hover:text-sky-700 dark:text-slate-400 dark:hover:text-sky-200',
                item.isActive &&
                  'bg-slate-100 text-sky-700 ring-1 ring-slate-200 dark:bg-slate-800/80 dark:text-sky-200 dark:ring-slate-700/60',
              ]}
              href={item.href}
              aria-current={item.isActive ? 'page' : undefined}
            >
              <span class="flex h-5 w-5 items-center justify-center">
                {item.icon === 'home' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 10.5 12 3l9 7.5" />
                    <path d="M5 9.5V21h14V9.5" />
                  </svg>
                )}
                {item.icon === 'blog' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 4h9a4 4 0 0 1 4 4v12H8a2 2 0 0 1-2-2V4Z" />
                    <path d="M6 16h13" />
                    <path d="M6 12h13" />
                  </svg>
                )}
                {item.icon === 'projects' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 7h8v12H4z" />
                    <path d="M12 5h8v14h-8" />
                    <path d="M7 10h2" />
                    <path d="M15 10h2" />
                  </svg>
                )}
                {item.icon === 'news' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 5h16v14H4z" />
                    <path d="M8 9h8" />
                    <path d="M8 13h6" />
                  </svg>
                )}
                {item.icon === 'search' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.5-3.5" />
                  </svg>
                )}
              </span>
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </nav>
    </div>

    <div
      class="fixed bottom-6 right-6 z-50 hidden w-[min(90vw,22rem)] rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-lg backdrop-blur dark:border-slate-800/60 dark:bg-slate-950/90"
      data-sw-update
      role="status"
      aria-live="polite"
    >
      <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">Update available</p>
      <p class="mt-1 text-xs text-slate-600 dark:text-slate-300">
        A new version is ready. Reload to update.
      </p>
      <div class="mt-3 flex items-center gap-2">
        <button
          type="button"
          class="rounded-full bg-sky-100 px-4 py-2 text-xs font-semibold text-sky-800 transition hover:bg-sky-200 dark:bg-sky-400/15 dark:text-sky-200 dark:hover:bg-sky-400/25"
          data-sw-refresh
        >
          Reload now
        </button>
      </div>
    </div>

    <script is:inline define:vars={{ baseUrl, enableServiceWorker }}>
      (() => {
        if (!enableServiceWorker || !('serviceWorker' in navigator)) {
          return;
        }

        const toast = document.querySelector('[data-sw-update]');
        const refreshButton = toast?.querySelector('[data-sw-refresh]');

        const showToast = () => {
          if (!toast) {
            return;
          }
          toast.classList.remove('hidden');
        };

        const promptUpdate = (registration) => {
          if (!registration?.waiting || !refreshButton) {
            return;
          }
          showToast();
          refreshButton.onclick = () => {
            registration.waiting.postMessage({ type: 'SKIP_WAITING' });
          };
        };

        navigator.serviceWorker.addEventListener('controllerchange', () => {
          window.location.reload();
        });

        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${baseUrl}sw.js`)
            .then((registration) => {
              if (registration.waiting && navigator.serviceWorker.controller) {
                promptUpdate(registration);
              }

              registration.addEventListener('updatefound', () => {
                const worker = registration.installing;
                if (!worker) {
                  return;
                }
                worker.addEventListener('statechange', () => {
                  if (worker.state === 'installed' && navigator.serviceWorker.controller) {
                    promptUpdate(registration);
                  }
                });
              });
            })
            .catch(() => {});
        });
      })();
    </script>
  </body>
</html>
