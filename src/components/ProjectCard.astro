---
type ProjectCardProps = {
  title: string;
  description: string;
  url: string;
  tags?: string[];
  stars?: number;
  updatedAt?: string;
  language?: string;
};

const {
  title,
  description,
  url,
  tags = [],
  stars,
  updatedAt,
  language,
} = Astro.props as ProjectCardProps;

const starsLabel = typeof stars === 'number' ? stars.toLocaleString('en-US') : null;
const updatedLabel = updatedAt
  ? new Date(updatedAt).toLocaleDateString('en-US', {
      month: 'short',
      day: '2-digit',
      year: 'numeric',
    })
  : null;

---

<a
  class="group flex h-full flex-col justify-between rounded-2xl border border-slate-200 bg-white/80 p-6 transition hover:-translate-y-1 hover:border-sky-400/60 hover:bg-slate-100/70 hover:shadow-[0_20px_40px_-20px_rgba(56,189,248,0.45)] dark:border-slate-800/60 dark:bg-slate-900/40 dark:hover:bg-slate-900/70"
  href={url}
  target="_blank"
  rel="noopener noreferrer"
>
  <div>
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{title}</h3>
      <svg
        class="h-4 w-4 text-slate-500 transition group-hover:text-sky-200 dark:text-slate-400"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M14 3h7v7" />
        <path d="M10 14 21 3" />
        <path d="M21 14v7h-7" />
        <path d="M3 10v11h11" />
      </svg>
    </div>
    <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{description}</p>
  </div>
  {(starsLabel || language || updatedLabel) && (
    <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
      {typeof stars === 'number' && <span>Stars {starsLabel}</span>}
      {language && <span>{language}</span>}
      {updatedLabel && <span>Updated {updatedLabel}</span>}
    </div>
  )}
  <div class="mt-3 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-wide text-slate-600 dark:border-slate-700/60 dark:text-slate-300">
        {tag}
      </span>
    ))}
  </div>
</a>
