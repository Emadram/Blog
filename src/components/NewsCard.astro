---
type NewsCardProps = {
  title: string;
  source: string;
  url: string;
  date: string;
  summary?: string;
  tags?: string[];
  readMinutes?: number;
  pinned?: boolean;
};

const {
  title,
  source,
  url,
  date,
  summary,
  tags = [],
  readMinutes,
  pinned,
} = Astro.props as NewsCardProps;
const published = new Date(date);
const isValidDate = !Number.isNaN(published.valueOf());
const formattedDate = isValidDate
  ? published.toLocaleDateString('en-US', {
      month: 'short',
      day: '2-digit',
      year: 'numeric',
    })
  : date;
const datetimeValue = isValidDate ? published.toISOString() : date;
const readLabel = typeof readMinutes === 'number' ? `${readMinutes} min` : null;
---

<a
  class="block rounded-2xl border border-slate-200 bg-white/80 p-4 transition hover:border-sky-400/60 hover:bg-slate-100 dark:border-slate-800/60 dark:bg-slate-950/40 dark:hover:bg-slate-900/60"
  href={url}
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="flex flex-wrap items-center justify-between gap-2 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
    <span>{source}</span>
    <div class="flex flex-wrap items-center gap-3">
      {readLabel && <span>{readLabel}</span>}
      <time datetime={datetimeValue}>{formattedDate}</time>
    </div>
  </div>
  <div class="mt-3 flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{title}</h3>
    {pinned && (
      <span class="rounded-full bg-sky-100 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-sky-700 dark:bg-sky-500/20 dark:text-sky-200">
        Pinned
      </span>
    )}
  </div>
  {summary && <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{summary}</p>}
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full border border-slate-200 px-3 py-1 text-xs uppercase tracking-wide text-slate-600 dark:border-slate-700/60 dark:text-slate-300">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
